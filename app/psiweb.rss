// The standard toolbar: the program's name, four buttons for the pen (Open
// an address, Back, the Home page, Pictures - the page's pictures on or
// off, pressed in while they show, as View > Show pictures), the clock.
// Zoom is on the View menu, its keys and the Zoom icons beside the screen.
// The pictures come from PsiWeb.mbm (web/tools/mkicons.py):
// CPwAppUi::ConstructL puts them on. View > Show toolbar (Ctrl+T) hides it
// and the page takes its room.
RESOURCE TOOLBAR r_pw_toolbar
	{
	breadth=KEikStdToolBarWidth;
	controls=
		{
		TBAR_CTRL
			{
			type=EEikCtLabel;
			flags=EEikToolBarCtrlHasSetMinLength;
			length=KEikStdFileNameLabelHeight;
			control=LABEL { txt="PsiWeb"; horiz_align=EEikLabelAlignHCenter; vert_align=EEikLabelAlignVCenter; };
			},
		TBAR_BUTTON { id=EPwCmdOpen; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Go to"; flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight; },
		TBAR_BUTTON { id=EPwCmdBack; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Back"; flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight; },
		TBAR_BUTTON { id=EPwCmdStart; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Start"; flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight; },
		TBAR_BUTTON { id=EPwCmdImages; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Pictures"; flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight; },
		TBAR_CTRL
			{
			type=EEikCtSpacer;
			flags=EEikToolBarCtrlHasSetMinLength|EEikToolBarCtrlIsStretchable;
			length=0;
			control=SPACER;
			},
		TBAR_CTRL
			{
			type=EEikCtClock;
			control=CLOCK { digitalresourceid=R_EIK_DIGITAL_CLOCK; analogresourceid=R_EIK_ANALOG_CLOCK; };
			},
		TBAR_CTRL
			{
			type=EEikCtSpacer;
			flags=EEikToolBarCtrlHasSetMinLength;
			length=KEikStdGapBelowClock;
			control=SPACER;
			}
		};
	}

// The toolband (0.78), along the top: Back, Forward, Reload, Stop and Home
// (16x16 colour pictures from PsiWeb.mbm, put on by CPwAppUi), the address
// (a tap or Ctrl+L, then type an address or words to search for, Enter
// goes there, Esc leaves it), how far the page has come, and Pictures (as
// the toolbar's). Shown at first on a tall screen (the netBook), where the
// toolbar is hidden and the page has the whole width; on the 5mx the
// toolbar as before, and Shift+Ctrl+T shows the toolband. Its buttons act
// at once, as the style guide asks.
RESOURCE TOOLBAND r_pw_toolband
	{
	breadth=KEikStdToolBandHeight;
	flags=EEikToolBarHorizontal|EEikToolBarDelayActivation;
	controls=
		{
		TBAR_BUTTON { id=EPwCmdBack; flags=EEikToolBarCtrlHasSetMinLength; length=EEikStdTwoStateIconicToolBandButtonWidth; bmpfile="*"; bmpid=EMbmBandBack; bmpmask=EMbmBandBackMask; },
		TBAR_BUTTON { id=EPwCmdForward; flags=EEikToolBarCtrlHasSetMinLength; length=EEikStdTwoStateIconicToolBandButtonWidth; bmpfile="*"; bmpid=EMbmBandForward; bmpmask=EMbmBandForwardMask; },
		TBAR_BUTTON { id=EPwCmdReloadStop; flags=EEikToolBarCtrlHasSetMinLength; length=EEikStdTwoStateIconicToolBandButtonWidth; bmpfile="*"; bmpid=EMbmBandReload; bmpmask=EMbmBandReloadMask; },
		TBAR_BUTTON { id=EPwCmdStart; flags=EEikToolBarCtrlHasSetMinLength; length=EEikStdTwoStateIconicToolBandButtonWidth; bmpfile="*"; bmpid=EMbmBandHome; bmpmask=EMbmBandHomeMask; },
		TBAR_CTRL { type=EEikCtSpacer; flags=EEikToolBarCtrlHasSetMinLength; length=6; control=SPACER; },
		TBAR_CTRL
			{
			type=EEikCtEdwin;
			id=EPwCtlAddress;
			flags=EEikToolBarCtrlIsStretchable;
			length=0;
			control=EDWIN { flags=EEikEdwinNoLineOrParaBreaks|EEikEdwinNoAutoSelection|EEikEdwinJustAutoCurEnd; width=20; lines=1; maxlength=500; };
			},
		TBAR_CTRL { type=EEikCtSpacer; flags=EEikToolBarCtrlHasSetMinLength; length=6; control=SPACER; },
		// (0.86) the route light: how the page came (Direct, Atom, PsiProxy),
		// a padlock for a secure page checked on the way, the page style's
		// letter when it is not Full; a tap is Page information
		TBAR_BUTTON { id=EPwCmdRouteLight; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Direct"; flags=EEikToolBarCtrlHasSetMinLength; length=EEikStdShortTextPopoutToolBandButtonWidth; bmpfile="*"; bmpid=EMbmBandNoLock; bmpmask=EMbmBandNoLockMask; },
		TBAR_CTRL { type=EEikCtSpacer; flags=EEikToolBarCtrlHasSetMinLength; length=6; control=SPACER; },
		TBAR_BUTTON { id=EPwCmdImages; flags=EEikToolBarCtrlHasSetMinLength; length=EEikStdTwoStateIconicToolBandButtonWidth; bmpfile="*"; bmpid=EMbmBandPictures; bmpmask=EMbmBandPicturesMask; }
		};
	}

// Shortcuts: EIKON's standard letters for the standard commands (Ctrl+E
// close, Ctrl+O open, Ctrl+M / Shift+Ctrl+M zoom, Ctrl+T toolbar, Ctrl+K
// preferences, Shift+Ctrl+H help, Shift+Ctrl+A about), the built-in Email program's Ctrl+U
// (disconnect) and Shift+Ctrl+Q (status information = Page info), and the
// browser's own: Ctrl+L also opens an address, Ctrl+H home, Ctrl+R reload,
// Ctrl+B back, Ctrl+F forward, Ctrl+I show pictures. (0.94) Ctrl+X, C and V
// are Edit's Cut, Copy and Paste (the address, or Paste into a box on the
// page); Ctrl+A selects the address being typed in, else stays with the
// page, as Ctrl+Z does; Esc stops a page loading.
RESOURCE HOTKEYS r_pw_hotkeys
	{
	control=
		{
		HOTKEY { command=EEikCmdExit; key='e'; },
		HOTKEY { command=EPwCmdOpen; key='o'; },
		HOTKEY { command=EPwCmdAddress; key='l'; },
		HOTKEY { command=EPwCmdHome; key='h'; },
		HOTKEY { command=EPwCmdReload; key='r'; },
		HOTKEY { command=EPwCmdBack; key='b'; },
		HOTKEY { command=EPwCmdForward; key='f'; },
		HOTKEY { command=EPwCmdZoomIn; key='m'; },
		HOTKEY { command=EPwCmdImages; key='i'; },
		HOTKEY { command=EPwCmdToggleToolbar; key='t'; },
		HOTKEY { command=EPwCmdPrefs; key='k'; },
		HOTKEY { command=EPwCmdHangup; key='u'; },
		HOTKEY { command=EEikCmdEditCut; key='x'; },
		HOTKEY { command=EEikCmdEditCopy; key='c'; },
		HOTKEY { command=EEikCmdEditPaste; key='v'; }
		};
	shift_control=
		{
		HOTKEY { command=EPwCmdZoomOut; key='m'; },
		HOTKEY { command=EPwCmdReading; key='b'; },
		HOTKEY { command=EPwCmdStyleNext; key='r'; },
		HOTKEY { command=EPwCmdToggleToolband; key='t'; },
		HOTKEY { command=EPwCmdAddFav; key='d'; },
		HOTKEY { command=EPwCmdPageInfo; key='q'; },
		HOTKEY { command=EPwCmdHelp; key='h'; },
		HOTKEY { command=EPwCmdAbout; key='a'; }
		};
	}

