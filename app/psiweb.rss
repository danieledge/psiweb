// The standard toolbar: the program's name, four buttons for the pen (Open
// an address, Back, Start - the start page with the favourites - and
// Pictures - the page's pictures on or off, pressed in while they show, as
// View > Show pictures), the clock. Zoom is on the View menu, its keys and
// the Zoom icons beside the screen. The pictures come from PsiWeb.mbm
// (tools/mkicons.py): CPwAppUi::ConstructL puts them on. View > Show >
// Toolbar (Ctrl+T) hides it and the page takes its room.
// (0.99) The name is a CEikFileNameLabel, as Psion's own programs have it
// (the program's name is set as the "file" name at start): on Coda that is
// the name box in the theme's colours. This one is the Series 5mx's (240
// lines, the SDK's 37-pixel buttons); a taller screen gets one of the two
// below in its place (CPwAppUi::TallToolbarL).
RESOURCE TOOLBAR r_pw_toolbar
	{
	breadth=KEikStdToolBarWidth;
	controls=
		{
		TBAR_CTRL
			{
			type=EEikCtFileNameLabel;
			id=EPwCtlFileName;
			flags=EEikToolBarCtrlHasSetMinLength;
			length=KEikStdFileNameLabelHeight;
			},
		TBAR_BUTTON { id=EPwCmdOpen; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Open"; flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight; },
		TBAR_BUTTON { id=EPwCmdBack; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Back"; flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight; },
		TBAR_BUTTON { id=EPwCmdStart; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Start"; flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight; },
		TBAR_BUTTON { id=EPwCmdImages; layout=EEikCmdButTextRightPictureLeft|EEikCmdButDenseFont|EEikCmdButExcessToText; txt="Pictures"; flags=EEikToolBarCtrlHasSetMinLength; length=KEikStdToolBarButtonHeight; },
		TBAR_CTRL
			{
			type=EEikCtSpacer;
			flags=EEikToolBarCtrlHasSetMinLength|EEikToolBarCtrlIsStretchable;
			length=0;
			control=SPACER;
			},
		TBAR_CTRL
			{
			type=EEikCtClock;
			control=CLOCK { digitalresourceid=R_EIK_DIGITAL_CLOCK; analogresourceid=R_EIK_ANALOG_CLOCK; };
			},
		TBAR_CTRL
			{
			type=EEikCtSpacer;
			flags=EEikToolBarCtrlHasSetMinLength;
			length=KEikStdGapBelowClock;
			control=SPACER;
			}
		};
	}

// (0.99) the netBook's toolbar (480 lines) as Coda gives Psion's own
// programs theirs (psion-netbook tools/toolbars.mts): the name box 24
// pixels, buttons of 50, then the battery, Coda's toolbar extras (the
// charge, the free memory, the brightness: PsiBatt) and Coda's clock above
// the gap. Types 0x7044, 0x7042 and 0x7043 are made by the hook Coda puts in
// Eikon's control factory, so this one is used only when the ROM has the
// hook (Z:\System\Libs\PsiBattHook.bin); without PsiBatt.dll the hook
// makes Psion's battery and clock from the same fields.
STRUCT PW_BATTERY             // the netBook's own battery's 17 bytes (type 0x47)
	{
	BYTE b0=0xff; BYTE b1=0xff; BYTE b2=0xff; BYTE b3=0xff;
	BYTE b4=0x0a; BYTE b5=0x00; BYTE b6=0x00; BYTE b7=0x03;
	BYTE b8=0x00; BYTE b9=0x00; BYTE b10=0x00; BYTE b11=0x18;
	BYTE b12=0x00; BYTE b13=0xb5; BYTE b14=0xb1; BYTE b15=0xf3; BYTE b16=0x00;
	}

RESOURCE TOOLBAR r_pw_toolbar_coda
	{
	breadth=KEikStdToolBarWidth;
	controls=
		{
		TBAR_CTRL
			{
			type=EEikCtFileNameLabel;
			id=EPwCtlFileName;
			flags=EEikToolBarCtrlHasSetMinLength;
