// PSIWEB.HRH - command and control ids for PsiWeb.app

enum TPwCommands
	{
	EPwCmdOpen = 0x1000,
	EPwCmdHome,
	EPwCmdReload,
	EPwCmdStop,
	EPwCmdBack,
	EPwCmdForward,
	EPwCmdTop,
	EPwCmdBottom,
	EPwCmdZoomIn,
	EPwCmdZoomOut,
	EPwCmdZoomNormal,
	EPwCmdImages,
	EPwCmdConnSettings,
	EPwCmdPrefs,
	EPwCmdPageInfo,
	EPwCmdRestart,
	EPwCmdAbout,
	EPwCmdUpdate,
	EPwCmdSendLog,           // Tools > Troubleshooting > Send log to helper (0.71)
	EPwCmdHangup,
	EPwCmdConnect,           // File > Connect (as PsiTerm's)
	EPwCmdToggleToolbar,
	EPwCmdHelp,              // Tools > Help on PsiWeb
	EPwCmdReading,           // View > Reading mode (docs/display.md)
	// Favourites and History (0.69)
	EPwCmdAddFav,            // Favourites > Add to favourites... (Shift+Ctrl+D)
	EPwCmdOrganiseFav,       // Favourites > Organise favourites...
	EPwCmdFavMore,           // Favourites > More favourites...
	EPwCmdHistory,           // Go > History (the cascade's own id)
	EPwCmdHistoryFull,       // History > Full history...
	EPwCmdClearHistory,      // History > Clear history
	EPwCmdHistNone,          // History > (No history), dimmed
	EPwCmdKeepLog,           // Tools > Keep a log (0.77)
	EPwCmdToggleToolband,    // View > Show toolband (Shift+Ctrl+T, 0.78)
	EPwCmdAddress,           // Ctrl+L: to the toolband's address (0.78)
	EPwCmdSetup,             // (0.85) Tools > Set up PsiWeb...
	EPwCmdStart,             // (0.85) Go > Start page
	EPwCmdShowMenu,          // (0.85) View > Show (the cascade's own id)
	EPwCmdLogMenu,           // (0.85) Tools > Troubleshooting (the cascade's own id; Log until 0.98)
	EPwCmdRetry,             // (0.85) a "Page not opened" page: Try again
	EPwCmdTestConn,          // (0.85) ...Test the connection
	EPwCmdStyleMenu,         // (0.86) View > Page style (the cascade's own id)
	EPwCmdStyleFull,         // (0.86) ...Full, Lighter, Reader, Text only, in PW_STYLE_* order
	EPwCmdStyleLighter,
	EPwCmdStyleReader,
	EPwCmdStyleText,
	EPwCmdStyleNext,         // (0.86) Shift+Ctrl+R: the next page style
	EPwCmdRouteLight,        // (0.86) the toolband's route light: Page information
	EPwCmdReloadStop,        // (0.87) the toolband's Reload, which is Stop while a page loads
	EPwCmdFullBrowser,       // (0.88) File > Open in full browser...
	EPwCmdCopyAddress,       // (0.94) Edit > Copy page address
	EPwCmdFav0 = 0x1100,     // the favourites on the menu: 16 slots
	EPwCmdHist0 = 0x1120     // the History cascade's pages: 16 slots
	};

// the toolband's own controls (0.78)
enum TPwBandControls
	{
	EPwCtlAddress = 0x1200,  // the address: what is showing, and where to go
	EPwCtlProgress           // how far the page has come
	};

