	EPwDlgUpdSource,
	EPwDlgUpdHost,
	EPwDlgUpdPort,
	EPwDlgUpdText,           // the update progress window
	EPwDlgAbout1,
	EPwDlgAbout2,
	EPwDlgAboutStatus,
	EPwDlgAbout4,
	EPwDlgAbout5,
	EPwDlgAbout6,
	EPwDlgHelpTopic,         // Help on PsiWeb
	EPwDlgHelpText,
	EPwDlgPictures,          // Preferences: pictures on every page (0.62)
	EPwDlgAuthWho,           // User name and password (Links phase 5)
	EPwDlgAuthRealm,
	EPwDlgAuthUser,
	EPwDlgAuthPass,
	EPwDlgText,              // Preferences > Text: sharp or scaled (docs/display.md)
	EPwDlgFavName,           // Add to favourites: Name
	EPwDlgFavUrl,            // ...and Address
	EPwDlgRecent,            // Open address: Recent
	EPwDlgOrgList,           // Favourites / History lists
	EPwDlgAbout7,            // (0.82) About: the IJG's sentence
	EPwDlgAbout8,            // (0.82) About: the Symbian STDLIB notice
	EPwDlgSearch,            // (0.85) Preferences: Search with
	EPwDlgSuPictures,        // (0.85) Set up PsiWeb > Pages
	EPwDlgSuPicturesNote,
	EPwDlgSuSearch,
	EPwDlgStyle,             // (0.86) Preferences: Page style
	EPwDlgSuStyle,           // (0.86) Set up PsiWeb > Pages: Page style
	EPwDlgSuStyleNote,
	EPwDlgCookies,           // (0.87) Preferences: Cookies
	EPwDlgFullServer,        // (0.88) Open in full browser: the server
	EPwDlgFullCommand,       // ...the program
	EPwDlgFullNote,
	EPwDlgAboutCoffee,       // (0.99) About: Buy me a coffee (the small font)
	EPwDlgCredit1,           // (0.99) About > Credits: the other people's code
	EPwDlgCredit2, EPwDlgCredit3, EPwDlgCredit4, EPwDlgCredit5, EPwDlgCredit6, EPwDlgCredit7, EPwDlgCredit8
	};

// (0.99) the toolbar's name box (Coda's, a CEikFileNameLabel) and Help's
// text with its scroll bar (a control of PsiWeb's own, CPwHelpText)
enum TPwOwnControls
	{
	EPwCtlFileName = 0x1210,
	EPwCtHelpText = 0x1300   // the custom control type (CPwHelpDialog::CreateCustomControlL)
	};

// Organise favourites: its buttons
enum TPwOrganiseButtons
	{
	EPwBidEdit = 0x7500,
	EPwBidDelete,
	EPwBidNew,               // (0.99) New...: a favourite typed in
	EPwBidCredits            // (0.99) About: Credits...
	};

// Connection settings > Test (0.74): the button, and the result dialog's lines
enum TPwLinkTest
	{
	EPwBidTest = 0x7400,
	EPwDlgTest1, EPwDlgTest2, EPwDlgTest3, EPwDlgTest4, EPwDlgTest5
	};

// Preferences > Screen greys... (0.84): the button, the same id in all
// three apps (ssh/psigreyui.cpp)
enum TPwGreyButton
	{
	EPwBidGreys = 0x7480
};

enum TPwConnPages
	{
	EPwPageLink = 0x300,
	EPwPageProxy,
	EPwPageSuPages           // (0.85) Set up PsiWeb > Pages
	};
