+/* (MEM-71) A page done: the finished pictures of other pages go. Links
+ * keeps the page before in its format cache, and with it its pictures'
+ * bitmaps, which the view test above cannot tell from this page's (their
+ * psi_py is a place on that page). The pictures of the page showing, in
+ * all its frames, are marked; every finished picture not marked is
+ * dropped (as above: it is decoded again from the cache if Back shows it)
+ * and forgets its place. Returns how many went. */
+static int psi_mark_now;
+
+static void psi_mark_fd(struct f_data_c *fd)
+{
+	struct g_object_image *goi;
+	struct list_head *l;
+	struct f_data_c *sub;
+	struct list_head *ls;
+	if (!fd) return;
+	if (fd->f_data) foreach(struct g_object_image, goi, l, fd->f_data->images)
+		if (goi->cimg) goi->cimg->psi_mark = psi_mark_now;
+	foreach(struct f_data_c, sub, ls, fd->subframes) psi_mark_fd(sub);
+}
+
+static void psi_drop_unmarked(struct cached_image *cimg, void *e_)
+{
+	int *freed = (int *)e_;
+	if (cimg->psi_mark == psi_mark_now) return;
+	cimg->psi_py = -1;
+	if (cimg->state < 12 || !(cimg->state & 1) || cimg == global_cimg) return;
+	psi_drop(cimg);
+	(*freed)++;
+}
+
+int psi_drop_other_pages(struct session *ses)
+{
+	int freed = 0;
+	if (!ses || !ses->screen) return 0;
+	if (++psi_mark_now == 0) psi_mark_now = 1;	/* (0 is "never marked") */
+	psi_mark_fd(ses->screen);
+	psi_imgcache_walk(psi_drop_unmarked, &freed);
+#ifdef PSI_DEBUG_MEM
+	fprintf(stderr, "[evict] page done: %d pictures of other pages dropped, bitmaps now %lu KB\n", freed, psi_pic_bytes >> 10);
+#endif
+	return freed;
+}
